# Copy to .env and fill in. Never commit .env.

# --- LLM (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
# Each analysis's API cost is logged and shown on the dashboard ("API cost").
# Managers (deep: the final calls) and analysts/debaters/trader (quick: ~15 calls, ~95% of the tokens).
# Per analysis: Opus + Haiku (default) ~$0.13, Opus + claude-sonnet-5-5 ~$0.80, Opus everywhere ~$1.50.
TA_DEEP_MODEL=claude-opus-5-5
TA_QUICK_MODEL=claude-haiku-5-5
# Thinking effort where the model supports it: low | medium | high
TA_EFFORT=low
# TradingAgents analysts: market, social, news, fundamentals
TA_ANALYSTS=market,social,news,fundamentals

# --- TradingAgents data vendors ---
# SEC asks for a contact identity, e.g. "Your Name you@example.com"
SEC_EDGAR_USER_AGENT=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Alpaca (paper) ---
# Python reads orders/positions with these; Claude places orders via the Alpaca MCP.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
# Required (exactly I_UNDERSTAND) before ALPACA_PAPER_TRADE=false is accepted
LIVE_CONFIRM=

# --- Scheduling ---
# The daily scan: screen the universe, then analyze held positions + the best candidates.
# New York time, at the latest SCAN_CUTOFF_MIN before the close. Not right after the open: the
# analysts read a 15-minute-old bar as "partial" and say Hold. Later cycles each hour only
# manage stops/exits (no LLM).
SCAN_TIME=14:00
# All TradingAgents analyses per scan. Held positions come first and candidates get the
# rest: 8 held -> 2 candidates. This is what bounds the API cost.
MAX_ANALYSES=10
# At most this many new candidates per scan (also capped at 3 per free position slot)
DAILY_SCANS=10
# TradingAgents analyses run in parallel
SCAN_WORKERS=3
# Don't start a scan this close to the close (minutes); it waits for the next day
SCAN_CUTOFF_MIN=90
# A candidate isn't re-analyzed within this many hours
REANALYZE_HOURS=20

# --- Risk ---
# Sell/Underweight opens a short (easy-to-borrow stocks only)
ALLOW_SHORTS=true
MAX_POSITIONS=10
# Base risk per trade as a fraction of equity (scaled by rating and track record)
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.15
MAX_SECTOR_PCT=0.30
CASH_RESERVE_PCT=0.10
# New buys pause for the day after this drawdown
DAILY_LOSS_LIMIT=0.03
LIMIT_EXPIRY_DAYS=3

# --- Benchmark ---
# Simulate a screener-only strategy (no LLM, no orders) next to the agent and compare both with SPY
BENCHMARK=true

# --- Email alerts (sent when the Anthropic API key runs out of credit) ---
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and paste it as SMTP_PASSWORD.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
# Recipient (defaults to SMTP_USER)
ALERT_EMAIL=

# --- Dashboard sharing ---
# off: only this PC. tailscale: also people on your Tailscale tailnet (read-only for them).
# See "Sharing the dashboard" in README.md.
DASHBOARD_SHARE=off

# Database, logs and the STOP kill-switch live here (default %LOCALAPPDATA%\trading-journey)
# TJ_DATA_DIR=
