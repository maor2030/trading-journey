# Copy to .env and fill in. Never commit .env.

# --- LLM (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
TA_DEEP_MODEL=claude-opus-5-5
TA_QUICK_MODEL=claude-sonnet-5-5

# --- TradingAgents data vendors ---
# SEC asks for a contact identity, e.g. "Your Name you@example.com"
SEC_EDGAR_USER_AGENT=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Execution ---
# local_paper: simulated $100k ledger (default)
# tradingview: execute via TradingView MCP if it exposes order tools; falls back to local_paper otherwise
BROKER=local_paper
TRADING_MODE=paper
# Required (exactly I_UNDERSTAND) before TRADING_MODE=live is accepted
LIVE_CONFIRM=
PAPER_STARTING_CASH=100000

# --- TradingView official MCP (OAuth with your TradingView account, Essential plan or higher) ---
TV_MCP_URL=https://mcp.tradingview.com/mcp
TV_OAUTH_CALLBACK_PORT=8765

# --- Scheduling ---
SCANS_PER_HOUR=5
MONITOR_MINUTES=5
# A stock isn't re-analyzed within this many hours
REANALYZE_HOURS=20

# --- Risk ---
MAX_POSITIONS=10
# Base risk per trade as a fraction of equity (scaled by rating and track record)
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.15
MAX_SECTOR_PCT=0.30
CASH_RESERVE_PCT=0.10
# New buys pause for the day after this drawdown
DAILY_LOSS_LIMIT=0.03
LIMIT_EXPIRY_DAYS=3

# Database, logs and the STOP kill-switch live here (default %LOCALAPPDATA%\trading-journey)
# TJ_DATA_DIR=
