# Copy to .env and fill in. Never commit .env.

# --- LLM (Anthropic / Claude) ---
ANTHROPIC_API_KEY=
TA_DEEP_MODEL=claude-opus-5-5
TA_QUICK_MODEL=claude-sonnet-5-5

# --- TradingAgents data vendors ---
# SEC asks for a contact identity, e.g. "Your Name you@example.com"
SEC_EDGAR_USER_AGENT=
FRED_API_KEY=
ALPHA_VANTAGE_API_KEY=

# --- Alpaca (paper) ---
# Python reads orders/positions with these; Claude places orders via the Alpaca MCP.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_PAPER_TRADE=true
# Required (exactly I_UNDERSTAND) before ALPACA_PAPER_TRADE=false is accepted
LIVE_CONFIRM=

# --- Scheduling ---
# The daily scan: screen the universe, then analyze held positions + the best candidates.
# New York time. Later cycles each hour only manage stops/exits (no LLM).
SCAN_TIME=09:45
# New candidates analyzed per scan (capped at 3 per free position slot)
DAILY_SCANS=15
# TradingAgents analyses run in parallel
SCAN_WORKERS=3
# Don't start a scan this close to the close (minutes); it waits for the next day
SCAN_CUTOFF_MIN=90
# A candidate isn't re-analyzed within this many hours
REANALYZE_HOURS=20

# --- Risk ---
MAX_POSITIONS=10
# Base risk per trade as a fraction of equity (scaled by rating and track record)
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.15
MAX_SECTOR_PCT=0.30
CASH_RESERVE_PCT=0.10
# New buys pause for the day after this drawdown
DAILY_LOSS_LIMIT=0.03
LIMIT_EXPIRY_DAYS=3

# Database, logs and the STOP kill-switch live here (default %LOCALAPPDATA%\trading-journey)
# TJ_DATA_DIR=
